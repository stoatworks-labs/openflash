{
  "name": "openflash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based installer for LineageOS and other alternative Android OSes, over WebUSB.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "devices": "node scripts/build-device-db.mjs",
    "check": "npm run typecheck && npm run check:sha256 && npm run check:unlock && npm run check:plans",
    "check:sha256": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/check-sha256.mjs",
    "check:unlock": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/check-unlock.mjs",
    "check:plans": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/check-plans.mjs"
  },
  "dependencies": {
    "@yume-chan/adb": "^2.6.3",
    "@yume-chan/adb-credential-web": "^2.1.0",
    "@yume-chan/adb-daemon-webusb": "^2.3.2",
    "@yume-chan/stream-extra": "^2.6.1",
    "android-fastboot": "^1.1.3"
  },
  "devDependencies": {
    "@types/w3c-web-usb": "^1.0.14",
    "js-yaml": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
